{
  "productName": "时序日历 2",
  "version": "2.1.2",
  "identifier": "cn.shixu.calendar.tauri",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build:renderer"
  },
  "app": {
    "windows": [{
      "title": "时序日历",
      "width": 1380,
      "height": 900,
      "minWidth": 480,
      "minHeight": 360,
      "resizable": true,
      "visible": false,
      "decorations": false,
      "transparent": true,
      "shadow": true
    }]
  },
  "bundle": {
    "createUpdaterArtifacts": true
  }
}
