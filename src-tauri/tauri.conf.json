{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "时序日历 Tauri 可行性测试",
  "version": "2.0.0-alpha.1",
  "identifier": "cn.shixu.calendar.tauri.dev",
  "build": {
    "frontendDist": "probe-ui"
  },
  "app": {
    "windows": [
      {
        "title": "时序日历 Tauri 可行性测试",
        "width": 640,
        "height": 420,
        "resizable": true,
      "visible": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "script-src": "'self'",
        "worker-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: asset: http://asset.localhost",
        "font-src": "'self' data:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "../build/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "../build/icon.ico"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENFMjRBOUIzOTZFQkVERTEKUldUaDdldVdzNmtrenVQc29CZ0M3SytZbXZNSm5xYVdvV0psVjBMb3dZTGNCaFYzSGZ4RFMrbmkK",
      "endpoints": ["https://github.com/xiaomohaa/shixu-calendar/releases/latest/download/latest.json"],
      "requireSignedVersion": true
    }
  }
}
